{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "around-the-table",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The client build is served as static assets; unknown paths fall back to the SPA.
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "AREAS", "class_name": "AreaRoom" },
      // One object for everyone's friends and presence; friendships live in its SQLite.
      { "name": "SOCIAL", "class_name": "SocialHub" },
    ],
  },
  // The free plan only supports SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AreaRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["SocialHub"] },
  ],
  "observability": { "enabled": true },
}
